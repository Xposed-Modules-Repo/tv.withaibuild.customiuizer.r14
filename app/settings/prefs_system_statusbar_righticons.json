            "android:defaultValue": "100",
            "app:indentLevel": "1",
            "app:minValue": "75",
            "app:maxValue": "125",
            "app:stepValue": "5",
            "app:format": "%d%%"
          }
        },
        {
          "type": "slider",
          "attributes": {
