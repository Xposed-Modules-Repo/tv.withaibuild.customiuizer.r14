{
  "type": "screen",
  "attributes": {
    "android:key": "pref_key_system_island_music_cat"
  },
  "children": [
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/system_island_music_group"
      },
      "children": [
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_island_media",
            "android:title": "@string/system_island_media_title",
            "android:defaultValue": "false",
            "android:summary": "@string/system_island_media_summ"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_island_media_swipe",
            "android:title": "@string/system_island_media_swipe_title",
            "android:defaultValue": "true",
            "android:summary": "@string/system_island_media_swipe_summ",
            "android:dependency": "pref_key_system_island_media"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_island_hide_in_floating_window",
            "android:title": "@string/system_island_hide_in_floating_window_title",
            "android:defaultValue": "false",
            "android:summary": "@string/system_island_hide_in_floating_window_summ",
            "android:dependency": "pref_key_system_island_media"
          }
        }
      ]
    }
  ]
}
